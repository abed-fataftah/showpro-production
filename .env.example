# Content-validation build mode (schema/validate.ts, CS §6.8).
# preview    -> clearly-marked placeholders are allowed (warn only)  [default when unset]
# production -> any remaining required placeholder FAILS the build
SITE_BUILD_MODE=preview
# Absolute site base URL for canonical links, Open Graph images, and sitemap (F-005).
# Placeholder in dev/preview; a real owner domain is required for production
# (a placeholder value FAILS the production build).
SITE_URL=https://PLACEHOLDER.example.com